+        /// <summary>
+        /// Gets the V4L2 M2M (VPU) video decoder for the stream, if that codec's hardware
+        /// decoding checkbox is ticked and the decoder is available. Emits an explicit
+        /// " -c:v &lt;codec&gt;_v4l2m2m" so the decode is visible/controllable (otherwise the
+        /// ffmpeg-sky1 auto-hwaccel would decode on the VPU implicitly). The V4L2 M2M decoder
+        /// outputs system-memory frames, so the software filter chain applies.
+        /// </summary>
+        public string GetV4l2VidDecoder(EncodingJobInfo state, EncodingOptions options, MediaStream videoStream, int bitDepth)
+        {
+            if (!OperatingSystem.IsLinux()
+                || state?.MediaSource is null
+                || options.HardwareAccelerationType != HardwareAccelerationType.v4l2m2m
+                || string.IsNullOrEmpty(videoStream?.Codec))
+            {
+                return null;
+            }
+
+            // Map the stream codec to (checkbox codec, V4L2 M2M decoder prefix).
+            string uiCodec, decoderPrefix;
+            switch (videoStream.Codec.ToLowerInvariant())
+            {
+                case "avc":
+                case "h264": uiCodec = "h264"; decoderPrefix = "h264"; break;
+                case "h265":
+                case "hevc": uiCodec = "hevc"; decoderPrefix = "hevc"; break;
+                case "mpeg1video": uiCodec = "mpeg1video"; decoderPrefix = "mpeg1"; break;
+                case "mpeg2video": uiCodec = "mpeg2video"; decoderPrefix = "mpeg2"; break;
+                case "mpeg4": uiCodec = "mpeg4"; decoderPrefix = "mpeg4"; break;
+                case "vc1": uiCodec = "vc1"; decoderPrefix = "vc1"; break;
+                case "vp8": uiCodec = "vp8"; decoderPrefix = "vp8"; break;
+                case "vp9": uiCodec = "vp9"; decoderPrefix = "vp9"; break;
+                case "av1": uiCodec = "av1"; decoderPrefix = "av1"; break;
+                default: return null;
+            }
+
+            // Gates on SupportsDecoder(<prefix>_v4l2m2m) and the codec being ticked in
+            // HardwareDecodingCodecs; returns " -c:v <prefix>_v4l2m2m" or null.
+            return GetHwDecoderName(options, decoderPrefix, "v4l2m2m", uiCodec, bitDepth);
+        }
+
+        private static string GetV4l2DecoderPrefix(string streamCodec)
+        {
+            switch (streamCodec?.ToLowerInvariant())
+            {
+                case "avc":
+                case "h264": return "h264";
+                case "h265":
+                case "hevc": return "hevc";
+                case "mpeg1video": return "mpeg1";
+                case "mpeg2video": return "mpeg2";
+                case "mpeg4": return "mpeg4";
+                case "vc1": return "vc1";
+                case "vp8": return "vp8";
+                case "vp9": return "vp9";
+                case "av1": return "av1";
+                default: return null;
+            }
+        }
+
+        /// <summary>
+        /// Determines whether the output video is encoded by a hardware encoder.
+        /// </summary>
+        /// <param name="state">Encoding state.</param>
+        /// <param name="options">Encoding options.</param>
+        /// <returns>Whether a hardware video encoder is used.</returns>
+        public bool IsHardwareVideoEncoder(EncodingJobInfo state, EncodingOptions options)
+        {
+            var encoder = GetVideoEncoder(state, options);
+            if (string.IsNullOrEmpty(encoder) || IsCopyCodec(encoder))
+            {
+                return false;
+            }
+
+            return encoder.Contains("_amf", StringComparison.OrdinalIgnoreCase)
+                || encoder.Contains("_nvenc", StringComparison.OrdinalIgnoreCase)
+                || encoder.Contains("_qsv", StringComparison.OrdinalIgnoreCase)
+                || encoder.Contains("_vaapi", StringComparison.OrdinalIgnoreCase)
+                || encoder.Contains("_videotoolbox", StringComparison.OrdinalIgnoreCase)
+                || encoder.Contains("_rkmpp", StringComparison.OrdinalIgnoreCase)
+                || encoder.Contains("_v4l2m2m", StringComparison.OrdinalIgnoreCase);
+        }
+
+        /// <summary>
+        /// Determines whether the input video is decoded by a hardware decoder. For V4L2 M2M this
+        /// also accounts for the ffmpeg-sky1 auto-hwaccel, which decodes on the VPU even when the
+        /// per-codec hardware-decoding checkbox is off.
+        /// </summary>
+        /// <param name="state">Encoding state.</param>
+        /// <param name="options">Encoding options.</param>
+        /// <returns>Whether a hardware video decoder is used.</returns>
+        public bool IsHardwareVideoDecoder(EncodingJobInfo state, EncodingOptions options)
+        {
+            if (state?.VideoStream is null || IsCopyCodec(state.OutputVideoCodec))
+            {
+                return false;
+            }
+
+            if (!string.IsNullOrEmpty(GetHardwareVideoDecoder(state, options)))
+            {
+                return true;
+            }
+
+            if (options.HardwareAccelerationType == HardwareAccelerationType.v4l2m2m)
+            {
+                var decoderPrefix = GetV4l2DecoderPrefix(state.VideoStream.Codec);
+                return decoderPrefix is not null
+                    && _mediaEncoder.SupportsDecoder(decoderPrefix + "_v4l2m2m");
+            }
+
+            return false;
+        }
